@using Platform.Shared.Dtos.Auth
@model LoginRequest
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-card card">
    <h1 class="auth-card__title">Sign in</h1>
    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="form-summary"></div>
        <form-field asp-for="Email" type="email" />
        <form-field asp-for="Password" type="password" />
        <div class="form-actions">
            <button type="submit" class="btn btn-primary auth-card__submit">Sign in</button>
        </div>
    </form>
</div>
