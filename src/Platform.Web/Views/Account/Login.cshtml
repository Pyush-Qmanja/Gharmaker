@* Sign-in form, inside the split-screen auth layout. *@
@using Platform.Shared.Dtos.Auth
@model LoginRequest
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<h1 class="auth__title">Welcome back</h1>
<p class="auth__subtitle">Sign in with your work email to continue.</p>

@if (ViewData[ViewDataKeys.Notice] is string notice)
{
    <p class="notice" role="status">@notice</p>
}

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate class="auth__form">
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>
    <form-field asp-for="Email" type="email" label="Work email" />
    <form-field asp-for="Password" type="password" />
    <button type="submit" class="btn btn-primary auth__submit">Sign in <icon name="@Icons.ArrowRight" /></button>
</form>

<p class="auth__help">Forgot your password or need an account? Ask your administrator.</p>
