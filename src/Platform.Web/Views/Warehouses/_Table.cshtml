@* Warehouse rows for the shared CrudIndex page. Only warehouses in the user's scope arrive here. *@
@using Platform.Shared.Dtos.Inventory
@model IReadOnlyList<WarehouseDto>
@{
    var userNames = ViewData[ViewDataKeys.UserNames] as IReadOnlyDictionary<Guid, string> ?? new Dictionary<Guid, string>();
}
<table class="table data-table">
    <thead>
        <tr>
            <th>Warehouse</th>
            <th>Code</th>
            <th>Type</th>
            <th>City</th>
            <th>Responsible</th>
            <th>Status</th>
            <th>Last updated</th>
            <th><span class="visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var warehouse in Model)
        {
            string? responsible = warehouse.OwnerUserId is { } ownerId && userNames.TryGetValue(ownerId, out var ownerName) ? ownerName : null;
            <tr>
                <td>
                    <div class="identity">
                        <span class="icon-tile icon-tile--sm icon-tile--warehouse"><icon name="@Icons.Warehouse" /></span>
                        <a asp-action="Edit" asp-route-id="@warehouse.Id" class="identity__primary">@warehouse.Name</a>
                    </div>
                </td>
                <td><span class="code-tag">@warehouse.Code</span></td>
                <td>@warehouse.Type.ToWords()</td>
                <td><span class="cell-with-icon"><icon name="@Icons.MapPin" /> @warehouse.Address.City</span></td>
                <td>
                    @if (responsible is null)
                    {
                        <span class="data-table__muted">—</span>
                    }
                    else
                    {
                        <span class="identity"><span class="avatar">@responsible.Initials()</span> @responsible</span>
                    }
                </td>
                <td><partial name="_StatusBadge" model="warehouse.IsActive" /></td>
                <td class="data-table__muted" title="@((warehouse.UpdatedAt ?? warehouse.CreatedAt).ToIstString())">@((warehouse.UpdatedAt ?? warehouse.CreatedAt).ToIstDateString())</td>
                <partial name="_RowActions" model="warehouse.Id" />
            </tr>
        }
    </tbody>
</table>
