@* Brand rows for the shared CrudIndex page. *@
@using Platform.Shared.Dtos.Catalog
@model IReadOnlyList<BrandDto>
<table class="table data-table">
    <thead>
        <tr>
            <th>Brand</th>
            <th>Slug</th>
            <th>Manufacturer</th>
            <th class="data-table__num">Order</th>
            <th>Status</th>
            <th>Last updated</th>
            <th><span class="visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var brand in Model)
        {
            <tr>
                <td>
                    <div class="identity">
                        <span class="avatar">@brand.Name.Initials()</span>
                        <a asp-action="Edit" asp-route-id="@brand.Id" class="identity__primary">@brand.Name</a>
                    </div>
                </td>
                <td><span class="code-tag">@brand.Slug</span></td>
                <td>@brand.ManufacturerName</td>
                <td class="data-table__num">@brand.DisplayOrder</td>
                <td><partial name="_StatusBadge" model="brand.IsActive" /></td>
                <td class="data-table__muted" title="@((brand.UpdatedAt ?? brand.CreatedAt).ToIstString())">@((brand.UpdatedAt ?? brand.CreatedAt).ToIstDateString())</td>
                <partial name="_RowActions" model="brand.Id" />
            </tr>
        }
    </tbody>
</table>
