@* Shown when the API answers 403: signed in, but the user's access does not include this action. *@
@{
    ViewData["Title"] = "Not allowed";
}

<div class="card">
    <div class="empty-state">
        <span class="empty-state__icon"><icon name="@Icons.Lock" /></span>
        <h1 class="empty-state__title">You don't have access to this</h1>
        <p class="empty-state__text">Your roles and feature access don't include this action here. Ask an administrator if you need it.</p>
        <div class="empty-state__actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to dashboard</a>
        </div>
    </div>
</div>
