@* Pager for any list page. Keeps the current search text and any extra filters (Model.RouteValues). *@
@model IListViewModel
@{
    Dictionary<string, string> RouteFor(int page)
    {
        var values = Model.RouteValues
            .Where(v => !string.IsNullOrEmpty(v.Value))
            .ToDictionary(v => v.Key, v => v.Value!);
        values["page"] = page.ToString();
        if (!string.IsNullOrEmpty(Model.Search))
        {
            values["search"] = Model.Search;
        }

        return values;
    }
}
@if (Model.TotalPages > 1)
{
    <nav class="pager" aria-label="Pages">
        <span class="pager__summary">Page @Model.Page of @Model.TotalPages · @Model.TotalCount records</span>
        <div class="pager__buttons">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-all-route-data="RouteFor(Model.Page - 1)">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-all-route-data="RouteFor(Model.Page + 1)">Next</a>
            }
        </div>
    </nav>
}
