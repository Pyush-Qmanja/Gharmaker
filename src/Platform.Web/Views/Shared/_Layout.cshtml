@* Master layout. All styles live in wwwroot/css and all scripts in wwwroot/js — never inline. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app">
    <header class="app-header">
        <nav class="app-nav container-fluid">
            <a class="app-nav__brand" asp-controller="Home" asp-action="Index">Platform</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="app-nav__links">
                    <li><a class="app-nav__link" asp-controller="Brands" asp-action="Index">Brands</a></li>
                </ul>
                <div class="app-nav__user">
                    <span class="app-nav__user-name">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                    </form>
                </div>
            }
        </nav>
    </header>

    <main class="app-main container">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
