@* App shell: sidebar, top bar and content. All styles live in wwwroot/css and all scripts in wwwroot/js — never inline. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="shell" data-shell>
        <aside class="sidebar" id="sidebar" aria-label="Main menu">
            <a class="sidebar__brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><icon name="@Icons.Logo" /></span>
                <span class="sidebar__brand-text">
                    <span class="sidebar__brand-name">@Branding.ProductName</span>
                    <span class="sidebar__brand-tag">@Branding.Tagline</span>
                </span>
            </a>
            <vc:navigation-menu />
        </aside>
        <div class="shell__overlay" data-sidebar-close></div>

        <div class="shell__main">
            <header class="topbar">
                <button type="button" class="icon-btn topbar__menu" data-sidebar-toggle aria-controls="sidebar" aria-label="Open menu">
                    <icon name="@Icons.Menu" />
                </button>
                <partial name="_Breadcrumb" />
                <div class="topbar__actions">
                    <a asp-area="Shop" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-secondary topbar__store" target="_blank" rel="noopener"><icon name="@Icons.Store" /> View store</a>
                    <partial name="_UserMenu" />
                </div>
            </header>

            <main class="content">
                <div class="content__inner">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <partial name="_Alerts" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
