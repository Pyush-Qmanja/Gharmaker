@* Shared list page for every CRUD screen. Rows come from the controller's own _Table partial. *@
@model IListViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-header">
    <h1 class="page-header__title">@Model.Title</h1>
    <a asp-action="Create" class="btn btn-primary">Add new</a>
</div>

<partial name="_SearchBar" model="Model" />

@if (Model.TotalCount == 0)
{
    <partial name="_EmptyState" model="Model" />
}
else
{
    <div class="card data-card">
        <partial name="_Table" model="Model.Items" />
    </div>
    <partial name="_Pagination" model="Model" />
}
