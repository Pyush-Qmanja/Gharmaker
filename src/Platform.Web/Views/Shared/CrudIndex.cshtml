@* Shared list page for every CRUD screen: header with the create action, then a card with search, the controller's own _Table partial and the pager. *@
@model IListViewModel
@{
    ViewData["Title"] = Model.Title;
    NavigationItem? screen = Navigation.Find(ViewContext.RouteData.Values["controller"] as string);
}

<div class="page-header">
    <div class="page-header__text">
        <h1 class="page-header__title">@Model.Title</h1>
        @if (screen is not null)
        {
            <p class="page-header__subtitle">@screen.Description</p>
        }
    </div>
    <div class="page-header__actions">
        @foreach (var link in ViewData[ViewDataKeys.HeaderLinks] as IReadOnlyList<HeaderLink> ?? Array.Empty<HeaderLink>())
        {
            <a asp-action="@link.Action" class="btn btn-secondary"><icon name="@link.Icon" /> @link.Text</a>
        }
        <a asp-action="Create" class="btn btn-primary"><icon name="@Icons.Plus" /> New @Model.ItemName</a>
    </div>
</div>

<div class="card data-card">
    <div class="data-card__toolbar">
        <partial name="_SearchBar" model="Model" />
        <span class="data-card__count">@Model.TotalCount.Counted(Model.ItemName)</span>
    </div>

    @if (Model.TotalCount == 0)
    {
        <partial name="_EmptyState" model="Model" />
    }
    else
    {
        <div class="data-card__scroll">
            <partial name="_Table" model="Model.Items" />
        </div>
        <partial name="_Pagination" model="Model" />
    }
</div>
