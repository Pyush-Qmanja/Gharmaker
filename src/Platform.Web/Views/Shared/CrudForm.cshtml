@* Shared create/edit page for every CRUD screen. Fields come from the controller's own _Form partial. *@
@model FormViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-header">
    <h1 class="page-header__title">@Model.Title</h1>
</div>

<div class="card form-card">
    <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="form-summary"></div>

        <partial name="_Form" model="Model.Form" />

        @if (Model.Form is IActivatableRequest activatable)
        {
            <partial name="_IsActiveField" model="activatable" />
        }

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
