@* Dashboard tiles for the screens the user may open. Rendered by NavigationMenuViewComponent. *@
@model IReadOnlyList<NavigationItem>
@if (Model.Count == 0)
{
    <div class="empty-state">
        <p class="empty-state__text">Your account has no screens yet. Ask an administrator to give you a role.</p>
    </div>
}
else
{
    <div class="tile-grid">
        @foreach (var item in Model)
        {
            <a class="tile card" asp-controller="@item.Controller" asp-action="Index">
                <span class="tile__title">@item.Title</span>
                <span class="tile__text">@item.Description</span>
            </a>
        }
    </div>
}
