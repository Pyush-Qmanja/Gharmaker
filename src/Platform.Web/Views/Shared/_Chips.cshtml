@* A short list of labels (roles, capabilities) as chips. Model is the labels. *@
@model IReadOnlyList<string>
@if (Model.Count == 0)
{
    <span class="chip chip--empty">None</span>
}
else
{
    <span class="chips">
        @foreach (var label in Model)
        {
            <span class="chip">@label</span>
        }
    </span>
}
