@* User fields for the shared CrudForm page. Sign-in fields appear only when creating. *@
@using Microsoft.AspNetCore.Mvc.Rendering
@using Platform.Shared.Dtos.Identity
@model IUserFields
<div class="form-grid">
    <form-field asp-for="Name" />
    <form-field asp-for="Phone" type="tel" hint="International format, e.g. +919876543210" />
</div>

@if (Model is CreateUserRequest create)
{
    <partial name="_SignInFields" model="create" />
}

<checkbox-list asp-for="RoleIds"
               items="(IEnumerable<SelectListItem>)ViewData[ViewDataKeys.RoleOptions]!"
               label="Roles"
               empty-text="No active roles yet — create one under Roles first." />

<checkbox-list asp-for="Scopes"
               items="(IEnumerable<SelectListItem>)ViewData[ViewDataKeys.ScopeOptions]!"
               label="Scope — where this user's roles apply" />
<p class="form-field__hint">Without a scope the user's roles apply nowhere. You can only grant scopes you hold yourself.</p>
