@* Import step 1: how the file works, template download, and upload. Column help comes from CatalogImportColumns so it always matches the importer. *@
@{
    ViewData["Title"] = "Import catalogue";
}

<nav class="breadcrumb-trail" aria-label="Back">
    <a asp-action="Index">Catalogue</a>
    <span class="breadcrumb-trail__sep">›</span>
    <span>Import</span>
</nav>

<div class="page-header">
    <h1 class="page-header__title">Import catalogue from Excel</h1>
</div>

<ol class="steps">
    <li class="card steps__item">
        <h2 class="steps__title">1. Download the template</h2>
        <p>It has example rows, the list of valid units, and these instructions.</p>
        <a asp-action="Template" class="btn btn-outline-primary">Download Excel template</a>
    </li>

    <li class="card steps__item">
        <h2 class="steps__title">2. Fill it in — one row per SKU (variant)</h2>
        <p>Group rows by category any way you like. Missing categories and brands are created for you;
           rows with the same brand and product become one product with several variants.</p>
        <table class="table data-table import-columns">
            <thead>
                <tr><th>Column</th><th>Required</th><th>What to enter</th></tr>
            </thead>
            <tbody>
                @foreach (var (name, required, help) in CatalogImportColumns.All)
                {
                    <tr>
                        <td><strong>@name</strong></td>
                        <td>@(required ? "Yes" : "No")</td>
                        <td>@help</td>
                    </tr>
                }
            </tbody>
        </table>
    </li>

    <li class="card steps__item">
        <h2 class="steps__title">3. Upload and check</h2>
        <p>Nothing is saved yet — you will see what each row will do and confirm first. Up to @CatalogImportColumns.MaxRows rows per file.</p>
        <form asp-action="Import" method="post" enctype="multipart/form-data" class="upload-form">
            <input type="file" name="file" accept=".xlsx,.csv" class="form-control" required />
            <button type="submit" class="btn btn-primary">Upload and check</button>
        </form>
        @Html.ValidationMessage("file", new { @class = "form-field__error" })
    </li>
</ol>
