@* Catalogue browse page: category tree on the left; brand filter, search and products on the right. *@
@model CatalogIndexViewModel
@{
    ViewData["Title"] = Model.CategoryName ?? "All products";
    bool filtered = !string.IsNullOrEmpty(Model.Products.Search) || Model.BrandId is not null;
}

<div class="page-header">
    <div class="page-header__text">
        <h1 class="page-header__title">@(Model.CategoryName ?? "All products")</h1>
        <p class="page-header__subtitle">Your internal product master, seen only by staff. Browse by category and brand, or search any word: name, brand, size or SKU code. Open a product to see its stock.</p>
    </div>
    @if (Model.CanImport)
    {
        <div class="page-header__actions">
            <a asp-action="Import" class="btn btn-primary"><icon name="@Icons.Upload" /> Import from Excel</a>
        </div>
    }
</div>

<div class="catalog-layout">
    <aside class="card catalog-layout__tree" aria-label="Categories">
        <div class="card__header">
            <h2 class="card__title"><icon name="@Icons.Folder" class="icon--sm" /> Categories</h2>
        </div>
        <div class="card__body">
            <partial name="_CategoryTree" model="new CategoryTreeModel(Model.Categories, Model.CategoryId, Model.BrandId, IsRoot: true)" />
        </div>
    </aside>

    <section class="card data-card">
        <form asp-action="Index" method="get" class="data-card__toolbar" role="search">
            @if (Model.CategoryId is { } categoryId)
            {
                <input type="hidden" name="categoryId" value="@categoryId" />
            }
            <div class="search-field">
                <icon name="@Icons.Search" class="search-field__icon" />
                <input type="search" name="search" value="@Model.Products.Search" class="form-control search-field__input"
                       placeholder="Search, e.g. tiscon 12" aria-label="Search products" />
            </div>
            <select name="brandId" class="form-select filter-select" aria-label="Brand" data-auto-submit>
                <option value="">All brands</option>
                @foreach (var brand in Model.BrandOptions)
                {
                    <option value="@brand.Value" selected="@brand.Selected">@brand.Text</option>
                }
            </select>
            @if (filtered)
            {
                <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-link">Clear filters</a>
            }
            <span class="data-card__count">@Model.Products.TotalCount.Counted(Model.Products.ItemName)</span>
        </form>

        @if (Model.Products.TotalCount == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><icon name="@(filtered ? Icons.Search : Icons.Package)" /></span>
                <h2 class="empty-state__title">@(filtered ? "No products match" : "No products here yet")</h2>
                <p class="empty-state__text">
                    @(filtered ? "Try another word, or clear the brand filter." : "Import a sheet of products to fill this category.")
                </p>
                @if (Model.CanImport && !filtered)
                {
                    <div class="empty-state__actions">
                        <a asp-action="Import" class="btn btn-primary"><icon name="@Icons.Upload" /> Import from Excel</a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="data-card__scroll">
                <partial name="_ProductTable" model="Model.Products.Items" />
            </div>
            <partial name="_Pagination" model="Model.Products" />
        }
    </section>
</div>
