@* Product page: category path, variants with their units, and a unit converter (P7) that runs on the server. *@
@using System.Globalization
@model ProductPageViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    var allUnits = product.Skus.SelectMany(s => s.Units.Select(u => u.Uom)).Distinct().ToList();
    string Number(decimal value) => Platform.Shared.Common.Quantity.Normalise(value).ToString(CultureInfo.InvariantCulture);
}

<div class="page-header">
    <div class="page-header__text">
        <nav class="page-header__eyebrow" aria-label="Category">
            <a asp-action="Index">All products</a>
            @foreach (var crumb in product.Breadcrumb)
            {
                <icon name="@Icons.ChevronRight" />
                <a asp-action="Index" asp-route-categoryId="@crumb.Id">@crumb.Name</a>
            }
        </nav>
        <h1 class="page-header__title">@product.Name</h1>
        <div class="page-header__meta">
            <span class="chip chip--primary"><icon name="@Icons.Tag" class="icon--sm" /> @product.BrandName</span>
            <span class="chip">HSN @product.HsnCode</span>
            <span class="chip">@product.Skus.Count.Counted("variant")</span>
            <partial name="_StatusBadge" model="product.IsActive" />
        </div>
    </div>
</div>

<section class="card data-card">
    <div class="card__header">
        <h2 class="card__title"><icon name="@Icons.Package" class="icon--sm" /> Variants</h2>
    </div>
    <div class="data-card__scroll">
        <table class="table data-table">
            <thead>
                <tr>
                    <th>SKU code</th>
                    <th>Variant</th>
                    <th>Stocked in</th>
                    <th>Its own conversions</th>
                    <th>Can be expressed in</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sku in product.Skus)
                {
                    <tr>
                        <td><span class="code-tag">@sku.Code</span></td>
                        <td class="data-table__primary">@sku.VariantLabel</td>
                        <td><span class="chip chip--primary">@sku.BaseUom</span></td>
                        <td>
                            @if (sku.Conversions.Count == 0)
                            {
                                <span class="chip chip--empty">None</span>
                            }
                            @foreach (var conversion in sku.Conversions)
                            {
                                <div class="conversion-line">1 @conversion.Uom = @Number(conversion.Factor) @sku.BaseUom</div>
                            }
                        </td>
                        <td><partial name="_Chips" model="sku.Units.Select(u => u.Uom).ToList()" /></td>
                        <td><partial name="_StatusBadge" model="sku.IsActive" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (product.Skus.Count > 0)
{
    <section class="card" aria-labelledby="converter-title">
        <div class="card__header">
            <div>
                <h2 id="converter-title" class="card__title"><icon name="@Icons.Convert" class="icon--sm" /> Unit converter</h2>
                <p class="card__subtitle">Uses this product's own conversions plus the standard ones (kg ↔ tonne, sqft ↔ sqm…).</p>
            </div>
        </div>
        <div class="card__body">
            <form asp-action="Product" asp-route-id="@product.Id" method="get" class="converter__form">
                <label class="converter__field">
                    <span class="form-field__label">Variant</span>
                    <select name="skuId" class="form-select">
                        @foreach (var sku in product.Skus)
                        {
                            <option value="@sku.Id" selected="@(sku.Id == Model.ConvertSkuId)">@sku.VariantLabel</option>
                        }
                    </select>
                </label>
                <label class="converter__field">
                    <span class="form-field__label">Amount</span>
                    <input type="number" name="value" step="any" min="0" class="form-control converter__value"
                           value="@(Model.ConvertValue?.ToString(CultureInfo.InvariantCulture) ?? "1")" />
                </label>
                <label class="converter__field">
                    <span class="form-field__label">From</span>
                    <select name="from" class="form-select">
                        @foreach (var unit in allUnits)
                        {
                            <option value="@unit" selected="@(unit == Model.ConvertFrom)">@unit</option>
                        }
                    </select>
                </label>
                <icon name="@Icons.ArrowRight" class="converter__arrow" />
                <label class="converter__field">
                    <span class="form-field__label">To</span>
                    <select name="to" class="form-select">
                        @foreach (var unit in allUnits)
                        {
                            <option value="@unit" selected="@(unit == (Model.ConvertTo ?? product.Skus[0].BaseUom))">@unit</option>
                        }
                    </select>
                </label>
                <button type="submit" class="btn btn-primary"><icon name="@Icons.Convert" /> Convert</button>
            </form>

            @if (Model.Conversion is { } result)
            {
                <p class="converter__result">
                    <span>@Number(result.From.Value) @result.From.Uom =</span>
                    <strong>@Number(result.To.Value) @result.To.Uom</strong>
                </p>
            }
            else if (Model.ConversionError is { } error)
            {
                <div class="notice notice--danger converter__error" role="alert">
                    <icon name="@Icons.AlertCircle" />
                    <p>@error</p>
                </div>
            }
        </div>
    </section>
}
