@* Product page: category path, variants with their units and stock, where it is stocked, and a unit converter (P7) that runs on the server. *@
@using System.Globalization
@model ProductPageViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    var allUnits = product.Skus.SelectMany(s => s.Units.Select(u => u.Uom)).Distinct().ToList();
    string Number(decimal value) => Platform.Shared.Common.Quantity.Normalise(value).ToString(CultureInfo.InvariantCulture);
    var stockRows = Model.StockRows.ToList();
}

<div class="page-header">
    <div class="page-header__text">
        <nav class="page-header__eyebrow" aria-label="Category">
            <a asp-action="Index">All products</a>
            @foreach (var crumb in product.Breadcrumb)
            {
                <icon name="@Icons.ChevronRight" />
                <a asp-action="Index" asp-route-categoryId="@crumb.Id">@crumb.Name</a>
            }
        </nav>
        <h1 class="page-header__title">@product.Name</h1>
        <div class="page-header__meta">
            <span class="chip chip--primary"><icon name="@Icons.Tag" class="icon--sm" /> @product.BrandName</span>
            <span class="chip">HSN @product.HsnCode</span>
            <span class="chip">@product.Skus.Count.Counted("variant")</span>
            <partial name="_StatusBadge" model="product.IsActive" />
        </div>
    </div>
</div>

<div class="notice">
    <icon name="@Icons.Info" />
    <p><strong>Internal catalogue.</strong> Only your staff see this page. Stock below is what your warehouses hold right now; a product is listed here whether or not it is in stock.</p>
</div>

<section class="card data-card">
    <div class="card__header">
        <h2 class="card__title"><icon name="@Icons.Package" class="icon--sm" /> Variants</h2>
    </div>
    <div class="data-card__scroll">
        <table class="table data-table data-table--wide">
            <thead>
                <tr>
                    <th>SKU code</th>
                    <th>Variant</th>
                    <th>Base unit</th>
                    <th>Its own conversions</th>
                    <th>Can be expressed in</th>
                    @if (Model.Stock is not null)
                    {
                        <th class="data-table__num">On hand</th>
                    }
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sku in product.Skus)
                {
                    <tr>
                        <td><span class="code-tag">@sku.Code</span></td>
                        <td class="data-table__primary">@sku.VariantLabel</td>
                        <td><span class="chip chip--primary">@sku.BaseUom</span></td>
                        <td>
                            @if (sku.Conversions.Count == 0)
                            {
                                <span class="chip chip--empty">None</span>
                            }
                            @foreach (var conversion in sku.Conversions)
                            {
                                <div class="conversion-line">1 @conversion.Uom = @Number(conversion.Factor) @sku.BaseUom</div>
                            }
                        </td>
                        <td><partial name="_Chips" model="sku.Units.Select(u => u.Uom).ToList()" /></td>
                        @if (Model.Stock is not null)
                        {
                            decimal onHand = Model.Stock.TryGetValue(sku.Id, out var skuStock) ? skuStock.TotalOnHand : 0;
                            <td class="data-table__num">
                                <a asp-controller="Stock" asp-action="Sku" asp-route-id="@sku.Id" title="Stock and movements of @sku.Code">
                                    <span class="qty@(onHand == 0 ? " qty--zero" : string.Empty)">@onHand.ToQuantityText()</span> <span class="qty__uom">@sku.BaseUom</span>
                                </a>
                            </td>
                        }
                        <td><partial name="_StatusBadge" model="sku.IsActive" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (Model.Stock is not null)
{
    <section class="card data-card" aria-labelledby="stock-title">
        <div class="card__header">
            <div>
                <h2 id="stock-title" class="card__title"><icon name="@Icons.Warehouse" class="icon--sm" /> Where it is stocked</h2>
                <p class="card__subtitle">Every variant in every warehouse you can see, in its base unit.</p>
            </div>
        </div>
        @if (stockRows.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state__icon"><icon name="@Icons.Inbox" /></span>
                <h2 class="empty-state__title">No stock in any warehouse yet</h2>
                <p class="empty-state__text">Stock appears here once goods are received, transferred in, or loaded as opening stock.</p>
                @if (Model.CanReceive || Model.CanLoadOpening)
                {
                    <div class="empty-state__actions">
                        @if (Model.CanReceive)
                        {
                            <a asp-controller="Receipts" asp-action="Create" class="btn btn-primary"><icon name="@Icons.Truck" /> Receive goods</a>
                        }
                        @if (Model.CanLoadOpening)
                        {
                            <a asp-controller="Stock" asp-action="Opening" class="btn btn-secondary"><icon name="@Icons.Upload" /> Load opening stock</a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="data-card__scroll">
                <table class="table data-table">
                    <thead>
                        <tr>
                            <th>Warehouse</th>
                            <th>SKU</th>
                            <th class="data-table__num">On hand</th>
                            <th class="data-table__num">Reserved</th>
                            <th class="data-table__num">Available</th>
                            <th>Last movement</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in stockRows)
                        {
                            <tr>
                                <td><a asp-controller="Stock" asp-action="Index" asp-route-warehouseId="@row.WarehouseId"><span class="code-tag">@row.WarehouseCode</span></a></td>
                                <td><a asp-controller="Stock" asp-action="Sku" asp-route-id="@row.SkuId"><span class="code-tag">@row.SkuCode</span></a></td>
                                <td class="data-table__num"><span class="qty@(row.OnHand == 0 ? " qty--zero" : string.Empty)">@row.OnHand.ToQuantityText()</span> <span class="qty__uom">@row.Uom</span></td>
                                <td class="data-table__num data-table__muted">@row.Reserved.ToQuantityText()</td>
                                <td class="data-table__num">@row.Available.ToQuantityText() <span class="qty__uom">@row.Uom</span></td>
                                <td class="data-table__muted" title="@row.LastMovedAt.ToIstString()">@(row.LastMovedAt is { } at ? at.ToIstDateString() : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@if (product.Skus.Count > 0)
{
    <section class="card" aria-labelledby="converter-title">
        <div class="card__header">
            <div>
                <h2 id="converter-title" class="card__title"><icon name="@Icons.Convert" class="icon--sm" /> Unit converter</h2>
                <p class="card__subtitle">Uses this product's own conversions plus the standard ones (kg ↔ tonne, sqft ↔ sqm…).</p>
            </div>
        </div>
        <div class="card__body">
            <form asp-action="Product" asp-route-id="@product.Id" method="get" class="converter__form">
                <label class="converter__field">
                    <span class="form-field__label">Variant</span>
                    <select name="skuId" class="form-select">
                        @foreach (var sku in product.Skus)
                        {
                            <option value="@sku.Id" selected="@(sku.Id == Model.ConvertSkuId)">@sku.VariantLabel</option>
                        }
                    </select>
                </label>
                <label class="converter__field">
                    <span class="form-field__label">Amount</span>
                    <input type="number" name="value" step="any" min="0" class="form-control converter__value"
                           value="@(Model.ConvertValue?.ToString(CultureInfo.InvariantCulture) ?? "1")" />
                </label>
                <label class="converter__field">
                    <span class="form-field__label">From</span>
                    <select name="from" class="form-select">
                        @foreach (var unit in allUnits)
                        {
                            <option value="@unit" selected="@(unit == Model.ConvertFrom)">@unit</option>
                        }
                    </select>
                </label>
                <icon name="@Icons.ArrowRight" class="converter__arrow" />
                <label class="converter__field">
                    <span class="form-field__label">To</span>
                    <select name="to" class="form-select">
                        @foreach (var unit in allUnits)
                        {
                            <option value="@unit" selected="@(unit == (Model.ConvertTo ?? product.Skus[0].BaseUom))">@unit</option>
                        }
                    </select>
                </label>
                <button type="submit" class="btn btn-primary"><icon name="@Icons.Convert" /> Convert</button>
            </form>

            @if (Model.Conversion is { } result)
            {
                <p class="converter__result">
                    <span>@Number(result.From.Value) @result.From.Uom =</span>
                    <strong>@Number(result.To.Value) @result.To.Uom</strong>
                </p>
            }
            else if (Model.ConversionError is { } error)
            {
                <div class="notice notice--danger converter__error" role="alert">
                    <icon name="@Icons.AlertCircle" />
                    <p>@error</p>
                </div>
            }
        </div>
    </section>
}
