@* Adds many PIN codes to one warehouse at once: paste a list, choose the delivery time. *@
@using Microsoft.AspNetCore.Mvc.Rendering
@model AddDeliveryAreasForm
@{
    ViewData["Title"] = "Add PIN codes";
    var warehouses = (IReadOnlyList<SelectListItem>)ViewData[ViewDataKeys.WarehouseOptions]!;
    string? ErrorFor(string key) => ViewData.ModelState.TryGetValue(key, out var entry) ? entry.Errors.FirstOrDefault()?.ErrorMessage : null;
}

<div class="page-header">
    <div class="page-header__text">
        <nav class="page-header__eyebrow" aria-label="Back">
            <a asp-action="Index">Delivery areas</a>
            <icon name="@Icons.ChevronRight" />
            <span>Add PIN codes</span>
        </nav>
        <h1 class="page-header__title">Add PIN codes</h1>
        <p class="page-header__subtitle">A PIN code already served by the warehouse just gets the new delivery time.</p>
    </div>
</div>

<form asp-action="Add" method="post" novalidate class="form-layout">
    <div asp-validation-summary="ModelOnly" class="form-summary"></div>

    <form-panel title="Warehouse" description="The warehouse that will deliver, and how many days it takes from order to delivery.">
        <div class="form-grid">
            <form-field asp-for="WarehouseId" label="Delivers from" items="warehouses" empty-option="Choose a warehouse" />
            <form-field asp-for="LeadTimeDays" label="Delivery time (days)" hint="0 = same day, 1 = next day." />
        </div>
    </form-panel>

    <form-panel title="PIN codes" description="Type or paste PIN codes separated by commas, spaces or new lines — up to 500 at a time.">
        <div class="form-field">
            <label class="form-field__label" for="Pincodes">PIN codes</label>
            <textarea id="Pincodes" name="Pincodes" rows="6" class="form-control form-control--mono" placeholder="411001, 411002, 411003">@Model.Pincodes</textarea>
            <span class="form-field__error">@ErrorFor("Pincodes")</span>
        </div>
    </form-panel>

    <div class="form-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><icon name="@Icons.Check" /> Add PIN codes</button>
    </div>
</form>
