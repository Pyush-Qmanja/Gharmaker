{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "platform-api",
    "Audience": "platform-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "Firebase": {
    "ProjectId": "",
    "CredentialsPath": "",
    "WebApiKey": "",
    "FirestoreEmulatorHost": "",
    "AuthEmulatorHost": ""
  },
  "Swagger": {
    "Enabled": false
  },
  "RateLimiting": {
    "Enabled": true,
    "ReadsPerMinute": 600,
    "WritesPerMinute": 120,
    "SignInsPerMinute": 10,
    "RegistrationsPerWindow": 5,
    "RegistrationWindowMinutes": 15,
    "CheckoutsPerMinute": 10,
    "TrustedProxies": []
  },
  "Storefront": {
    "HoldMinutes": 2880,
    "ExpirySweepSeconds": 60
  }
}
